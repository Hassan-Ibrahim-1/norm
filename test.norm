x := fn () int {
    add_2 := fn (y: int) {
        some_string := fn () string {
            return "hey";
        }

        print(some_string());
        print(add(2,y));
    }

    add_2(3);
    return 2 + 3;
}

add := fn (a: int, b: int) int {
    return a + b;
}

{
    y := x();
    print(y);
}
