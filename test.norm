x := fn () int {
    add_2 := fn (y: int) {
        some_string := fn () string {
            return "hey";
        }

        print(some_string());
        if y >= 3 {
            print(add(2,y));
        } else if y <= 0 {
            print(y);
        } else {
            print(y+3);
        }
    }

    add_2(3);
    return 2 + 3;
}

add := fn (a: int, b: int) int {
    return a + b;
}

{
    y := x();
    print(y);
}
